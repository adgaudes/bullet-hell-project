# Normalize text while preserving Windows checkout compatibility.
* text=auto
*.md text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Unreal Engine binary assets.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# 3D source and interchange files.
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

# Rilievo di base cotto del terreno continuo (D-085, levels/district/base.bin).
*.bin filter=lfs diff=lfs merge=lfs -text

# Raster images and texture sources.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text

# Audio and video sources.
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text

# Fonts are binary and must retain exact bytes.
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# PDF: binario, mai conversione di fine riga.
*.pdf binary

# Godot: scene e risorse sono testo e devono restare diffabili.
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.cfg text eol=lf

# Librerie native degli addon Godot (GDExtension).
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
