; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Prototype01"
config/description="Survivor-like 3D isometrico. Prototipo di trasformazione del terreno."
run/main_scene="res://scenes/main/companion_slice.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120

[autoload]

GameSettings="*res://scripts/services/game_settings.gd"
PauseMenu="*res://scenes/ui/pause_menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=3

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="player"
3d_physics/layer_3="hazard"
3d_physics/layer_4="companion"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
rendering_device/vsync/frame_queue_size=1

